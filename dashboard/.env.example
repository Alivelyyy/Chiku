# ─────────────────────────────────────────────────
# Chiku Dashboard — Environment Variables
# Copy this file to .env.local and fill in values.
# ─────────────────────────────────────────────────

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# Discord OAuth2 App  (https://discord.com/developers/applications)
# Required scopes: identify, guilds
DISCORD_CLIENT_ID=your-discord-app-client-id
DISCORD_CLIENT_SECRET=your-discord-app-client-secret

# Bot REST API
# Public URL of the bot host (Pterodactyl) — must be reachable by Vercel
BOT_API_URL=https://your-pterodactyl-host.com:3001
# Must match DASHBOARD.API_KEY in config.yml
BOT_API_KEY=change-me-to-a-long-random-secret-key
